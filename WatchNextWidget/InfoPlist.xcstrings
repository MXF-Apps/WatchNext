    "NSLocalNetworkUsageDescription" : {
      "comment" : "System local network permission explanation. Keep the Apple-defined key unchanged.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext connects to your media servers on your local network to refresh the widget."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext se connecte à vos serveurs multimédias sur votre réseau local pour actualiser le widget."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext 会连接您本地网络上的媒体服务器以刷新小组件。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext はウィジェットを更新するためにローカルネットワーク上のメディアサーバーに接続します。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل WatchNext بخوادم الوسائط على شبكتك المحلية لتحديث الأداة."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext подключается к медиасерверам в локальной сети, чтобы обновлять виджет."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext verbindet sich mit deinen Medienservern im lokalen Netzwerk, um das Widget zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext se conecta a tus servidores multimedia en la red local para actualizar el widget."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O WatchNext se conecta aos seus servidores de mídia na rede local para atualizar o widget."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext si connette ai tuoi server multimediali sulla rete locale per aggiornare il widget."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext maakt verbinding met je mediaservers in het lokale netwerk om de widget te vernieuwen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext는 위젯을 새로 고치기 위해 로컬 네트워크의 미디어 서버에 연결합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext 會連線至您本機網路上的媒體伺服器以重新整理小工具。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext łączy się z serwerami multimediów w sieci lokalnej, aby odświeżyć widżet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext, widget’ı yenilemek için yerel ağınızdaki medya sunucularına bağlanır."
          }
        }
      }
