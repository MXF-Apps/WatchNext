    "media.release.now.label": {
      "comment": "Compact relative time for a release within thirty seconds of now.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "now"
          }
        },
        "fr": {
