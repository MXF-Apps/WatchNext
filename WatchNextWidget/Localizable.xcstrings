{
  "sourceLanguage": "en",
  "strings": {
    "media.availability.quality.label": {
      "comment": "Quality is a server-provided video format such as 1080p.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$(quality)@ • Ready"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$(quality)@ • Disponible"
          }
        }
      }
    },
    "media.availability.ready.label": {
      "comment": "One media item is available to watch.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible"
          }
        }
      }
    },
    "media.download.pending.accessibilityLabel": {
      "comment": "VoiceOver label for the missing download symbol.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not downloaded yet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore téléchargé"
          }
        }
      }
    },
    "media.release.episode.accessibilityLabel": {
      "comment": "VoiceOver label. Time is a localized relative release date.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aired %1$(time)@, not downloaded yet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffusion %1$(time)@, pas encore téléchargé"
          }
        }
      }
    },
    "media.release.episode.label": {
      "comment": "Time is a localized relative date such as “2 hours ago”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aired %1$(time)@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffusion %1$(time)@"
          }
        }
      }
    },
