    "widget.configuration.description": {
      "comment": "Widget configuration intent description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows your ready-to-watch and upcoming media."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche vos contenus disponibles et à venir."
          }
        }
      }
    },
    "widget.configuration.sectionTitles.description": {
      "comment": "Description of the headerless layout option.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small and large widgets. Off replaces the section titles with a divider that carries the overflow counts and the refresh button, which fits more items."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petits et grands widgets. Désactivez cette option pour remplacer les titres par un séparateur avec les nombres d’éléments supplémentaires et le bouton d’actualisation, afin d’afficher plus de contenus."
          }
        }
      }
    },
    "widget.configuration.sectionTitles.title": {
      "comment": "Toggles visible section headings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Section Titles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titres des sections"
          }
        }
      }
    },
    "widget.configuration.title": {
      "comment": "Configuration intent product name. Do not translate.",
