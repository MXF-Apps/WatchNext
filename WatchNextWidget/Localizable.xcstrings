    "widget.configuration.description" : {
      "comment" : "Widget configuration intent description.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows your ready-to-watch and upcoming media."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche vos contenus disponibles et à venir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示可观看和即将推出的媒体。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴可能な作品と近日公開の作品を表示します。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض الوسائط الجاهزة للمشاهدة والقادمة."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает готовые к просмотру и предстоящие медиа."
          }
        }
      }
    },
    "widget.configuration.sectionTitles.description" : {
      "comment" : "Description of the headerless layout option.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small and large widgets. Off replaces the section titles with a divider that carries the overflow counts and the refresh button, which fits more items."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petits et grands widgets. Désactivez cette option pour remplacer les titres par un séparateur avec les nombres d’éléments supplémentaires et le bouton d’actualisation, afin d’afficher plus de contenus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于小号和大号小组件。关闭后，分区标题将替换为一条带溢出计数和刷新按钮的分隔线，以容纳更多项目。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小と大のウィジェット向け。オフにすると、セクションタイトルの代わりに、超過件数と更新ボタンを含む区切り線が表示され、より多くの項目が収まります。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأداتان الصغيرة والكبيرة. عند الإيقاف تُستبدل عناوين الأقسام بفاصل يحمل أعداد الفائض وزر التحديث، فيتسع لعناصر أكثر."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для маленького и большого виджетов. Если выключить, заголовки разделов заменяются разделителем со счётчиками и кнопкой обновления, и помещается больше элементов."
          }
        }
      }
    },
