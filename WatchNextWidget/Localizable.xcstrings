    "media.season.additionalEpisodes.accessibilityLabel": {
      "comment": "VoiceOver explanation of a folded season badge. Count excludes the visible episode.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$(count)lld additional episode"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$(count)lld additional episodes"
                }
              }
            }
          }
