    "widget.configuration.description" : {
      "comment" : "Widget configuration intent description.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows your ready-to-watch and upcoming media."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche vos contenus disponibles et à venir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示可观看和即将推出的媒体。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴可能な作品と近日公開の作品を表示します。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض الوسائط الجاهزة للمشاهدة والقادمة."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает готовые к просмотру и предстоящие медиа."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt deine Medien, die bereit sind oder demnächst erscheinen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra tus contenidos listos para ver y los próximos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra suas mídias prontas para assistir e as que estão por vir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra i contenuti pronti da guardare e quelli in arrivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont je media die klaar zijn om te kijken en die binnenkort komen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시청 가능하거나 공개 예정인 미디어를 표시합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示可觀看和即將推出的媒體。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje media gotowe do obejrzenia i nadchodzące."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlemeye hazır ve yakında çıkacak medyanızı gösterir."
          }
        }
      }
    },
    "widget.configuration.sectionTitles.description" : {
      "comment" : "Description of the headerless layout option.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small and large widgets. Off replaces the section titles with a divider that carries the overflow counts and the refresh button, which fits more items."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petits et grands widgets. Désactivez cette option pour remplacer les titres par un séparateur avec les nombres d’éléments supplémentaires et le bouton d’actualisation, afin d’afficher plus de contenus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于小号和大号小组件。关闭后，分区标题将替换为一条带溢出计数和刷新按钮的分隔线，以容纳更多项目。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小と大のウィジェット向け。オフにすると、セクションタイトルの代わりに、超過件数と更新ボタンを含む区切り線が表示され、より多くの項目が収まります。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأداتان الصغيرة والكبيرة. عند الإيقاف تُستبدل عناوين الأقسام بفاصل يحمل أعداد الفائض وزر التحديث، فيتسع لعناصر أكثر."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для маленького и большого виджетов. Если выключить, заголовки разделов заменяются разделителем со счётчиками и кнопкой обновления, и помещается больше элементов."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleines und großes Widget. Aus ersetzt die Abschnittstitel durch eine Trennlinie mit den Überlaufzahlen und dem Aktualisieren-Knopf, sodass mehr Einträge passen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets pequeño y grande. Desactivado sustituye los títulos de sección por un separador con los recuentos sobrantes y el botón de actualizar, así caben más elementos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets pequeno e grande. Desativado substitui os títulos das seções por um separador com as contagens excedentes e o botão de atualizar, cabendo mais itens."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget piccolo e grande. Disattivato sostituisce i titoli delle sezioni con un separatore che contiene i conteggi in eccesso e il pulsante di aggiornamento, così entrano più elementi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine en grote widget. Uit vervangt de sectietitels door een scheidingslijn met de overlooptellingen en de vernieuwknop, zodat er meer items passen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작은 위젯과 큰 위젯에 적용됩니다. 끄면 섹션 제목이 초과 개수와 새로 고침 버튼이 있는 구분선으로 바뀌어 더 많은 항목이 들어갑니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適用於小型和大型小工具。關閉後，區段標題會換成帶有溢出計數和重新整理按鈕的分隔線，以容納更多項目。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widżety mały i duży. Wyłączone zastępuje tytuły sekcji separatorem z liczbą pozostałych i przyciskiem odświeżania, dzięki czemu mieści się więcej elementów."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küçük ve büyük widget’lar. Kapalıyken bölüm başlıkları, taşan sayıları ve yenile düğmesini taşıyan bir ayırıcıyla değiştirilir; böylece daha fazla öğe sığar."
          }
        }
      }
    },
