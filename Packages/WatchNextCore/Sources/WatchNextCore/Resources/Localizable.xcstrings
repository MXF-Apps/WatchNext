    "media.season.additionalEpisodes": {
      "comment": "Number of additional episodes after the displayed episode.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "and %lld more"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "and %lld more"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "et %lld de plus"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "et %lld de plus"
                }
              }
            }
          }
        }
      }
    },
    "media.series.unknown.title": {
      "comment": "Series title shown for an episode whose series record could not be loaded from Sonarr.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown Series"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Série inconnue"
          }
        }
      }
    },
    "network.error.configuration.message": {
      "comment": "Argument is the localized name of a missing configuration field, including its article.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure %@ before refreshing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez %@ avant d’actualiser."
          }
        }
      }
    },
    "network.error.decoding.message": {
      "comment": "User-facing network error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service response was not understood. Check that the server version is supported."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse du service n’a pas pu être interprétée. Vérifiez que la version du serveur est prise en charge."
          }
        }
      }
    },
    "network.error.invalidResponse.message": {
      "comment": "User-facing network error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service returned an invalid response."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service a renvoyé une réponse invalide."
          }
        }
      }
    },
    "network.error.invalidURL.message": {
      "comment": "User-facing network error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service URL is invalid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’URL du service est invalide."
          }
        }
      }
    },
    "network.error.server.message": {
      "comment": "Argument is an HTTP status code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service returned HTTP %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service a renvoyé le code HTTP %lld."
          }
        }
      }
    },
    "network.error.unauthorized.message": {
      "comment": "User-facing network error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication failed. Check the configured credentials."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’authentification. Vérifiez les identifiants configurés."
          }
        }
      }
    },
    "security.keychain.error.message": {
      "comment": "Fallback error when the system does not provide a Keychain error description. Argument is OSStatus.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain error %d."
          }
        },
