    "network.error.decoding.message" : {
      "comment" : "User-facing network error.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The service response was not understood. Check that the server version is supported."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réponse du service n’a pas pu être interprétée. Vérifiez que la version du serveur est prise en charge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法理解服务器的响应。请检查服务器版本是否受支持。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスの応答を解釈できませんでした。サーバーのバージョンが対応しているか確認してください。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُفهم ردّ الخدمة. تأكد من أن إصدار الخادم مدعوم."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответ сервиса не распознан. Убедитесь, что версия сервера поддерживается."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Antwort des Dienstes wurde nicht verstanden. Prüfe, ob die Serverversion unterstützt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se entendió la respuesta del servicio. Comprueba que la versión del servidor sea compatible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A resposta do serviço não foi compreendida. Verifique se a versão do servidor é compatível."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La risposta del servizio non è stata compresa. Verifica che la versione del server sia supportata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het antwoord van de dienst werd niet begrepen. Controleer of de serverversie wordt ondersteund."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서비스 응답을 이해할 수 없습니다. 서버 버전이 지원되는지 확인하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法理解服務的回應。請確認伺服器版本受支援。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedź usługi nie została zrozumiana. Sprawdź, czy wersja serwera jest obsługiwana."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hizmet yanıtı anlaşılamadı. Sunucu sürümünün desteklendiğini kontrol edin."
          }
        }
      }
    },
