{
  "sourceLanguage": "en",
  "strings": {
    "media.filter.all.title": {
      "comment": "Display title for filtering media. Never use this localized text as a stored identifier.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout"
          }
        }
      }
    },
