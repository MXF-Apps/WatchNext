    "feed.empty.all.message": {
      "comment": "Guidance for an empty filtered feed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull to refresh, or review Settings and Diagnostics for details."
