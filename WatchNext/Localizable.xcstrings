        }
      }
    },
    "issue.advice.unauthorized" : {
      "comment" : "Advice under a refresh error when a server rejected the credentials. Argument: Sonarr, Radarr, or Jellyfin.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ rejected the saved credentials. Replace the key or sign in again under Settings › Servers."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ a refusé les identifiants enregistrés. Remplacez la clé ou reconnectez-vous dans Réglages › Serveurs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ 拒绝了已保存的凭据。请在“设置 › 服务器”中更换密钥或重新登录。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ が保存済みの認証情報を拒否しました。「設定 › サーバー」でキーを置き換えるか、再度サインインしてください。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
