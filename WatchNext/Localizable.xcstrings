          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ 서버가 응답하지 않습니다. 설정 › 서버에서 주소를 확인하고 서버가 실행 중인지 확인하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ 沒有回應。請在「設定 › 伺服器」中檢查其位址，並確認伺服器正在執行。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ nie odpowiedział. Sprawdź adres w Ustawienia › Serwery i czy serwer działa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
