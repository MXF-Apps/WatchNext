    "feed.welcome.message" : {
      "comment" : "First launch explanation. Product names stay unchanged.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your Sonarr, Radarr and Jellyfin servers in Settings, or look around with a fictional library first."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez vos serveurs Sonarr, Radarr et Jellyfin dans les réglages, ou découvrez l’app avec une bibliothèque fictive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中添加您的 Sonarr、Radarr 和 Jellyfin 服务器，或先用虚构的媒体库看看。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」で Sonarr、Radarr、Jellyfin のサーバーを追加するか、まず架空のライブラリで試してみてください。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضِف خوادم Sonarr وRadarr وJellyfin في الإعدادات، أو استكشف أولًا بمكتبة خيالية."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте серверы Sonarr, Radarr и Jellyfin в настройках или сначала осмотритесь на вымышленной библиотеке."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge deine Sonarr-, Radarr- und Jellyfin-Server in den Einstellungen hinzu oder sieh dich zuerst in einer fiktiven Mediathek um."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tus servidores Sonarr, Radarr y Jellyfin en Ajustes, o echa un vistazo primero con una biblioteca ficticia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione seus servidores Sonarr, Radarr e Jellyfin em Ajustes, ou explore antes com uma biblioteca fictícia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi i tuoi server Sonarr, Radarr e Jellyfin nelle Impostazioni, oppure dai prima un’occhiata con una libreria fittizia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg je Sonarr-, Radarr- en Jellyfin-servers toe in Instellingen, of kijk eerst rond met een fictieve bibliotheek."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 Sonarr, Radarr, Jellyfin 서버를 추가하거나 먼저 가상의 라이브러리로 둘러보세요."
          }
        },
        "zh-Hant" : {
