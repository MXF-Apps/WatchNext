    "issue.localNetwork.noAuth.advice" : {
      "comment" : "Next step after iOS refused local network browsing.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Local Network for WatchNext in the Settings app, then try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Réseau local pour WatchNext dans l’app Réglages, puis réessayez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”应用中为 WatchNext 开启“本地网络”，然后重试。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」アプリで WatchNext の「ローカルネットワーク」をオンにしてから、もう一度お試しください。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل «الشبكة المحلية» لـ WatchNext في تطبيق الإعدادات، ثم أعد المحاولة."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Локальная сеть» для WatchNext в приложении «Настройки» и повторите попытку."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere „Lokales Netzwerk“ für WatchNext in der Einstellungen-App und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa «Red local» para WatchNext en la app Ajustes y vuelve a intentarlo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative “Rede local” para o WatchNext no app Ajustes e tente novamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva «Rete locale» per WatchNext nell’app Impostazioni, poi riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet ‘Lokaal netwerk’ voor WatchNext aan in de app Instellingen en probeer het opnieuw."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 앱에서 WatchNext의 로컬 네트워크를 켠 다음 다시 시도하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」App 中為 WatchNext 開啟「本機網路」，然後再試一次。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz „Sieć lokalna” dla WatchNext w aplikacji Ustawienia i spróbuj ponownie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar uygulamasında WatchNext için Yerel Ağ’ı açıp yeniden deneyin."
          }
        }
      }
    },
    "issue.localNetwork.noAuth.message" : {
      "comment" : "Shown when iOS refuses local network browsing (DNS error NoAuth).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS did not allow WatchNext to look for devices on the local network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS n’a pas autorisé WatchNext à rechercher des appareils sur le réseau local."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 未允许 WatchNext 查找本地网络上的设备。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS が WatchNext によるローカルネットワーク上のデバイス検索を許可しませんでした。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يسمح iOS لـ WatchNext بالبحث عن أجهزة على الشبكة المحلية."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS не разрешила WatchNext искать устройства в локальной сети."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat WatchNext nicht erlaubt, nach Geräten im lokalen Netzwerk zu suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS no permitió que WatchNext buscara dispositivos en la red local."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS não permitiu que o WatchNext procurasse dispositivos na rede local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS non ha permesso a WatchNext di cercare dispositivi sulla rete locale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS heeft WatchNext niet toegestaan naar apparaten in het lokale netwerk te zoeken."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS가 WatchNext의 로컬 네트워크 기기 검색을 허용하지 않았습니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 未允許 WatchNext 尋找本機網路上的裝置。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS nie pozwolił WatchNext szukać urządzeń w sieci lokalnej."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS, WatchNext’in yerel ağdaki aygıtları aramasına izin vermedi."
          }
        }
      }
    },
    "issue.localNetwork.timeout.advice" : {
      "comment" : "Next step after the local network check ended without an answer.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answer the permission prompt if it is showing, or check Local Network for WatchNext in the Settings app, then try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondez à la demande d’autorisation si elle est affichée, ou vérifiez Réseau local pour WatchNext dans l’app Réglages, puis réessayez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果正在显示权限提示，请先回应；或在“设置”应用中检查 WatchNext 的“本地网络”权限，然后重试。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "権限のダイアログが表示されていれば応答するか、「設定」アプリで WatchNext の「ローカルネットワーク」を確認してから、もう一度お試しください。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجِب على طلب الإذن إذا كان معروضًا، أو تحقق من «الشبكة المحلية» لـ WatchNext في تطبيق الإعدادات، ثم أعد المحاولة."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответьте на запрос разрешения, если он показан, или проверьте «Локальная сеть» для WatchNext в приложении «Настройки», затем повторите попытку."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantworte die Berechtigungsanfrage, falls sie angezeigt wird, oder prüfe „Lokales Netzwerk“ für WatchNext in der Einstellungen-App und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde a la solicitud de permiso si aparece, o comprueba «Red local» para WatchNext en la app Ajustes y vuelve a intentarlo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responda ao pedido de permissão se ele aparecer, ou verifique “Rede local” para o WatchNext no app Ajustes e tente novamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondi alla richiesta di autorizzazione se è visibile, oppure controlla «Rete locale» per WatchNext nell’app Impostazioni, poi riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantwoord de toestemmingsvraag als die zichtbaar is, of controleer ‘Lokaal netwerk’ voor WatchNext in de app Instellingen en probeer het opnieuw."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한 요청이 표시되어 있으면 응답하거나, 설정 앱에서 WatchNext의 로컬 네트워크를 확인한 다음 다시 시도하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若正顯示權限提示請先回應，或在「設定」App 中檢查 WatchNext 的「本機網路」，然後再試一次。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedz na prośbę o uprawnienie, jeśli jest widoczna, albo sprawdź „Sieć lokalna” dla WatchNext w aplikacji Ustawienia i spróbuj ponownie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görünüyorsa izin istemini yanıtlayın veya Ayarlar uygulamasında WatchNext için Yerel Ağ’ı kontrol edip yeniden deneyin."
          }
        }
      }
    },
    "issue.localNetwork.timeout.message" : {
