    "settings.windows.upcoming.unlimited.message" : {
      "comment" : "Explanation of the unlimited upcoming window, actually capped at one year.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coming Soon lists every monitored episode and movie with a release date in the next year."
          }
        },
        "fr" : {
          "stringUnit" : {
