    "issue.advice.serverError" : {
      "comment" : "Advice under a refresh error when a server answered with an error or unexpected data. Argument: server product name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ answered with an error. Check that the server runs a supported version."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ a renvoyé une erreur. Vérifiez que le serveur utilise une version prise en charge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ 返回了错误。请检查服务器是否运行受支持的版本。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ がエラーを返しました。サーバーが対応バージョンで動作しているか確認してください。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجاب %1$(service)@ بخطأ. تأكد من أن الخادم يعمل بإصدار مدعوم."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ ответил ошибкой. Убедитесь, что сервер работает на поддерживаемой версии."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ hat mit einem Fehler geantwortet. Prüfe, ob der Server eine unterstützte Version ausführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ respondió con un error. Comprueba que el servidor use una versión compatible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ respondeu com um erro. Verifique se o servidor usa uma versão compatível."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ ha risposto con un errore. Verifica che il server usi una versione supportata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ antwoordde met een fout. Controleer of de server een ondersteunde versie draait."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ 서버가 오류로 응답했습니다. 지원되는 버전인지 확인하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ 回應了錯誤。請確認伺服器執行的是受支援的版本。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ odpowiedział błędem. Sprawdź, czy serwer działa w obsługiwanej wersji."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
