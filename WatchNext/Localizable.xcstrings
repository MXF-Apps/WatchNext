    "feed.empty.movies.message" : {
      "comment" : "Guidance for an empty filtered feed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No movies right now. Switch to All or Shows, or pull to refresh."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun film pour le moment. Choisissez Tout ou Séries, ou tirez vers le bas pour actualiser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前没有电影。切换到“全部”或“剧集”，或下拉刷新。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在映画はありません。「すべて」または「番組」に切り替えるか、下に引いて更新してください。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد أفلام حاليًا. بدّل إلى الكل أو المسلسلات، أو اسحب للتحديث."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фильмов пока нет. Переключитесь на «Все» или «Сериалы» либо потяните вниз для обновления."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Momentan keine Filme. Wechsle zu „Alle“ oder „Serien“ oder ziehe zum Aktualisieren nach unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay películas ahora mismo. Cambia a Todo o Series, o desliza para actualizar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum filme no momento. Mude para Tudo ou Séries, ou puxe para atualizar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun film al momento. Passa a Tutto o Serie, oppure trascina per aggiornare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Momenteel geen films. Schakel naar Alles of Series, of trek omlaag om te vernieuwen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 영화가 없습니다. 전체 또는 시리즈로 전환하거나 아래로 당겨 새로 고치세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前沒有電影。切換到「全部」或「影集」，或下拉重新整理。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak filmów. Przełącz na Wszystko lub Seriale albo pociągnij, aby odświeżyć."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anda film yok. Tümü veya Diziler seçeneğine geçin ya da yenilemek için aşağı çekin."
          }
        }
      }
    },
