    "settings.windows.recent.message": {
      "comment": "Explains the recent import cutoff. Days is the configured lookback.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ready to Watch lists what Sonarr and Radarr imported in the last %1$(days)lld day and you have not watched in Jellyfin. Older imports drop off even if unwatched."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ready to Watch lists what Sonarr and Radarr imported in the last %1$(days)lld days and you have not watched in Jellyfin. Older imports drop off even if unwatched."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "À regarder affiche les imports de Sonarr et Radarr du dernier jour que vous n’avez pas vus dans Jellyfin. Les imports plus anciens disparaissent, même s’ils n’ont pas été vus."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "À regarder affiche les imports de Sonarr et Radarr des %1$(days)lld derniers jours que vous n’avez pas vus dans Jellyfin. Les imports plus anciens disparaissent, même s’ils n’ont pas été vus."
                }
              }
            }
          }
        }
      }
    },
    "settings.windows.recent.unlimited.label": {
