    "settings.windows.footer" : {
      "comment" : "Instructions for the day steppers.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Step a window down to 0 to remove its limit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
