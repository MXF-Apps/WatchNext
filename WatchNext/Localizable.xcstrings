          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ отклонил сохранённые учётные данные. Замените ключ или войдите заново в разделе «Настройки › Серверы»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ hat die gespeicherten Zugangsdaten abgelehnt. Ersetze den Schlüssel oder melde dich unter Einstellungen › Server erneut an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ rechazó las credenciales guardadas. Sustituye la clave o vuelve a iniciar sesión en Ajustes › Servidores."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ rejeitou as credenciais salvas. Substitua a chave ou entre novamente em Ajustes › Servidores."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ ha rifiutato le credenziali salvate. Sostituisci la chiave o accedi di nuovo in Impostazioni › Server."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ heeft de opgeslagen aanmeldgegevens geweigerd. Vervang de sleutel of meld je opnieuw aan onder Instellingen › Servers."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ 서버가 저장된 자격 증명을 거부했습니다. 설정 › 서버에서 키를 교체하거나 다시 로그인하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ 拒絕了已儲存的憑證。請在「設定 › 伺服器」中更換金鑰或重新登入。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ odrzucił zapisane dane logowania. Zamień klucz lub zaloguj się ponownie w Ustawienia › Serwery."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ kayıtlı kimlik bilgilerini reddetti. Ayarlar › Sunucular bölümünde anahtarı değiştirin veya yeniden oturum açın."
          }
        }
      }
    },
    "issue.advice.unreachable" : {
      "comment" : "Advice under a refresh error when a server did not answer. Argument: server product name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ did not answer. Check its address under Settings › Servers and that the server is running."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
