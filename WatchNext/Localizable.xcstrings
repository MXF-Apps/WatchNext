    "settings.windows.recent.unlimited.message": {
      "comment": "Explanation of unlimited recent imports.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready to Watch lists everything Sonarr and Radarr imported that you have not watched in Jellyfin, up to the newest 250 imports per service."
