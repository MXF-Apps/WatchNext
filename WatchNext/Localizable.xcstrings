    "settings.demo.footer" : {
      "comment" : "Demo mode explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows a fictional library in the app and the widgets so you can try WatchNext without servers. Your server settings are kept and used again when this is off."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche une bibliothèque fictive dans l’app et les widgets pour essayer WatchNext sans serveurs. Vos réglages sont conservés et réutilisés lorsque ce mode est désactivé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在应用和小组件中显示虚构的媒体库，让您无需服务器即可试用 WatchNext。关闭后将继续使用您保存的服务器设置。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリとウィジェットに架空のライブラリを表示し、サーバーなしで WatchNext を試せます。サーバー設定は保持され、オフにすると再び使われます。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض مكتبة خيالية في التطبيق والأدوات لتجربة WatchNext دون خوادم. تبقى إعدادات خوادمك محفوظة وتُستخدم مجددًا عند إيقاف هذا الخيار."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает вымышленную библиотеку в приложении и виджетах, чтобы попробовать WatchNext без серверов. Настройки серверов сохраняются и снова используются после отключения."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt in der App und den Widgets eine fiktive Mediathek, damit du WatchNext ohne Server ausprobieren kannst. Deine Servereinstellungen bleiben erhalten und werden wieder verwendet, sobald dies aus ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una biblioteca ficticia en la app y los widgets para que pruebes WatchNext sin servidores. Tus ajustes de servidor se conservan y se vuelven a usar cuando esto está desactivado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra uma biblioteca fictícia no app e nos widgets para você experimentar o WatchNext sem servidores. Seus ajustes de servidor são mantidos e usados novamente quando isto estiver desativado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra una libreria fittizia nell’app e nei widget, così puoi provare WatchNext senza server. Le impostazioni dei server vengono conservate e riutilizzate quando questa opzione è disattivata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont een fictieve bibliotheek in de app en de widgets, zodat je WatchNext zonder servers kunt proberen. Je serverinstellingen blijven bewaard en worden weer gebruikt zodra dit uit staat."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱과 위젯에 가상의 라이브러리를 표시하여 서버 없이 WatchNext를 사용해 볼 수 있습니다. 서버 설정은 유지되며 이 옵션을 끄면 다시 사용됩니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 App 和小工具中顯示虛構的媒體庫，讓您無需伺服器即可試用 WatchNext。伺服器設定會保留，關閉後會再次使用。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje fikcyjną bibliotekę w aplikacji i widżetach, aby wypróbować WatchNext bez serwerów. Ustawienia serwerów są zachowywane i używane ponownie po wyłączeniu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu olmadan WatchNext’i denemeniz için uygulamada ve widget’larda kurgusal bir kitaplık gösterir. Sunucu ayarlarınız saklanır ve bu kapatıldığında yeniden kullanılır."
          }
        }
      }
    },
