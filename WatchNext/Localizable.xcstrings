    "settings.windows.recent.unlimited.message" : {
      "comment" : "Explanation of unlimited recent imports.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ready to Watch lists everything Sonarr and Radarr imported that you have not watched in Jellyfin, up to the newest 250 imports per service."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À regarder affiche les éléments importés par Sonarr et Radarr que vous n’avez pas vus dans Jellyfin, dans la limite des 250 derniers imports par service."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“可观看”列出 Sonarr 和 Radarr 导入且您尚未在 Jellyfin 中观看的所有内容，每个服务最多显示最新的 250 项导入。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「視聴可能」には、Sonarr と Radarr が取り込み、Jellyfin でまだ視聴していないすべてのものが、サービスごとに最新 250 件まで表示されます。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض «جاهز للمشاهدة» كل ما استورده Sonarr وRadarr ولم تشاهده في Jellyfin، حتى أحدث 250 استيرادًا لكل خدمة."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Готово к просмотру» показывает всё, что Sonarr и Radarr загрузили и что вы ещё не смотрели в Jellyfin, до 250 последних загрузок на сервис."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bereit zum Ansehen“ listet alles, was Sonarr und Radarr importiert haben und du in Jellyfin noch nicht gesehen hast, bis zu den neuesten 250 Importen pro Dienst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Listo para ver» muestra todo lo que Sonarr y Radarr importaron y que no has visto en Jellyfin, hasta las 250 importaciones más recientes por servicio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Pronto para assistir” lista tudo o que o Sonarr e o Radarr importaram e que você ainda não assistiu no Jellyfin, até as 250 importações mais recentes por serviço."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Pronti da guardare» elenca tutto ciò che Sonarr e Radarr hanno importato e che non hai ancora visto in Jellyfin, fino alle 250 importazioni più recenti per servizio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Klaar om te kijken’ toont alles wat Sonarr en Radarr hebben geïmporteerd en wat je nog niet in Jellyfin hebt bekeken, tot de 250 nieuwste imports per dienst."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시청 가능에는 Sonarr와 Radarr가 가져왔고 Jellyfin에서 아직 시청하지 않은 모든 항목이 서비스별 최신 250개까지 표시됩니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「可觀看」列出 Sonarr 和 Radarr 匯入且您尚未在 Jellyfin 觀看的所有內容，每個服務最多顯示最新的 250 項匯入。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Gotowe do obejrzenia” pokazuje wszystko, co Sonarr i Radarr zaimportowały i czego nie obejrzałeś w Jellyfin, do 250 najnowszych importów na usługę."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlemeye hazır, Sonarr ve Radarr’ın içe aktardığı ve Jellyfin’de henüz izlemediğiniz her şeyi hizmet başına en yeni 250 içe aktarmaya kadar listeler."
          }
        }
      }
