    "settings.appearance.footer" : {
      "comment" : "Footer under the Appearance section explaining the background texture picker.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A soft accent gradient and film grain behind the lists and widgets. Rows keep their contrast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un léger dégradé et un grain de pellicule derrière les listes et les widgets. Les lignes gardent leur contraste."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在列表和小组件后方加入柔和的强调色渐变与胶片颗粒。各行保持原有对比度。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストとウィジェットの背景に、やわらかなアクセントグラデーションとフィルムグレインを加えます。行のコントラストは維持されます。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدرّج لوني ناعم وحبيبات فيلم خلف القوائم والأدوات. تحافظ الصفوف على تباينها."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мягкий акцентный градиент и зернистость за списками и виджетами. Контраст строк сохраняется."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein sanfter Akzentverlauf mit Filmkorn hinter Listen und Widgets. Die Zeilen behalten ihren Kontrast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un degradado de acento suave y grano de película detrás de las listas y los widgets. Las filas conservan su contraste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um gradiente de destaque suave e granulação de filme atrás das listas e dos widgets. As linhas mantêm o contraste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sfumatura tenue del colore d’accento e una grana da pellicola dietro elenchi e widget. Le righe mantengono il contrasto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een zachte accentgradiënt en filmkorrel achter lijsten en widgets. Rijen behouden hun contrast."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록과 위젯 뒤에 부드러운 강조색 그라데이션과 필름 그레인을 더합니다. 행의 대비는 유지됩니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在列表和小工具後方加入柔和的強調色漸層與底片顆粒。各列保持原有對比度。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delikatny gradient akcentu i ziarno filmowe za listami i widżetami. Wiersze zachowują kontrast."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listelerin ve widget’ların arkasında yumuşak bir vurgu gradyanı ve film greni. Satırlar kontrastını korur."
          }
        }
      }
    },
