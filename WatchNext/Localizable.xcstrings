    "issue.localNetwork.noAuth.advice" : {
      "comment" : "Next step after iOS refused local network browsing.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Local Network for WatchNext in the Settings app, then try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Réseau local pour WatchNext dans l’app Réglages, puis réessayez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”应用中为 WatchNext 开启“本地网络”，然后重试。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」アプリで WatchNext の「ローカルネットワーク」をオンにしてから、もう一度お試しください。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل «الشبكة المحلية» لـ WatchNext في تطبيق الإعدادات، ثم أعد المحاولة."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Локальная сеть» для WatchNext в приложении «Настройки» и повторите попытку."
          }
        }
      }
    },
    "issue.localNetwork.noAuth.message" : {
      "comment" : "Shown when iOS refuses local network browsing (DNS error NoAuth).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS did not allow WatchNext to look for devices on the local network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS n’a pas autorisé WatchNext à rechercher des appareils sur le réseau local."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 未允许 WatchNext 查找本地网络上的设备。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS が WatchNext によるローカルネットワーク上のデバイス検索を許可しませんでした。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يسمح iOS لـ WatchNext بالبحث عن أجهزة على الشبكة المحلية."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS не разрешила WatchNext искать устройства в локальной сети."
          }
        }
      }
    },
    "issue.localNetwork.timeout.advice" : {
      "comment" : "Next step after the local network check ended without an answer.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answer the permission prompt if it is showing, or check Local Network for WatchNext in the Settings app, then try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondez à la demande d’autorisation si elle est affichée, ou vérifiez Réseau local pour WatchNext dans l’app Réglages, puis réessayez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果正在显示权限提示，请先回应；或在“设置”应用中检查 WatchNext 的“本地网络”权限，然后重试。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "権限のダイアログが表示されていれば応答するか、「設定」アプリで WatchNext の「ローカルネットワーク」を確認してから、もう一度お試しください。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجِب على طلب الإذن إذا كان معروضًا، أو تحقق من «الشبكة المحلية» لـ WatchNext في تطبيق الإعدادات، ثم أعد المحاولة."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответьте на запрос разрешения, если он показан, или проверьте «Локальная сеть» для WatchNext в приложении «Настройки», затем повторите попытку."
          }
        }
      }
    },
