    "issue.advice.missingConfiguration" : {
      "comment" : "Advice under a refresh error when a server address or credential is missing. Argument: server product name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the missing %1$(service)@ details under Settings › Servers."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les informations %1$(service)@ manquantes dans Réglages › Serveurs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置 › 服务器”中补全缺少的 %1$(service)@ 信息。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 › サーバー」で不足している %1$(service)@ の情報を追加してください。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضِف بيانات %1$(service)@ الناقصة في الإعدادات › الخوادم."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте недостающие данные %1$(service)@ в разделе «Настройки › Серверы»."
          }
        }
      }
    },
    "issue.advice.serverError" : {
      "comment" : "Advice under a refresh error when a server answered with an error or unexpected data. Argument: server product name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ answered with an error. Check that the server runs a supported version."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ a renvoyé une erreur. Vérifiez que le serveur utilise une version prise en charge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ 返回了错误。请检查服务器是否运行受支持的版本。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ がエラーを返しました。サーバーが対応バージョンで動作しているか確認してください。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجاب %1$(service)@ بخطأ. تأكد من أن الخادم يعمل بإصدار مدعوم."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ ответил ошибкой. Убедитесь, что сервер работает на поддерживаемой версии."
          }
        }
      }
    },
    "issue.advice.unauthorized" : {
      "comment" : "Advice under a refresh error when a server rejected the credentials. Argument: Sonarr, Radarr, or Jellyfin.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ rejected the saved credentials. Replace the key or sign in again under Settings › Servers."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ a refusé les identifiants enregistrés. Remplacez la clé ou reconnectez-vous dans Réglages › Serveurs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ 拒绝了已保存的凭据。请在“设置 › 服务器”中更换密钥或重新登录。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ が保存済みの認証情報を拒否しました。「設定 › サーバー」でキーを置き換えるか、再度サインインしてください。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض %1$(service)@ بيانات الاعتماد المحفوظة. استبدل المفتاح أو سجّل الدخول مجددًا في الإعدادات › الخوادم."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ отклонил сохранённые учётные данные. Замените ключ или войдите заново в разделе «Настройки › Серверы»."
          }
        }
      }
    },
    "issue.advice.unreachable" : {
      "comment" : "Advice under a refresh error when a server did not answer. Argument: server product name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ did not answer. Check its address under Settings › Servers and that the server is running."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ ne répond pas. Vérifiez son adresse dans Réglages › Serveurs et que le serveur est en marche."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ 没有响应。请在“设置 › 服务器”中检查其地址，并确认服务器正在运行。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ が応答しません。「設定 › サーバー」でアドレスを確認し、サーバーが動作しているか確認してください。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يستجب %1$(service)@. تحقق من عنوانه في الإعدادات › الخوادم ومن أن الخادم يعمل."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(service)@ не отвечает. Проверьте его адрес в разделе «Настройки › Серверы» и убедитесь, что сервер запущен."
          }
        }
      }
    },
    "issue.localNetwork.failed.message" : {
