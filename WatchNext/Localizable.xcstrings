    },
    "feed.empty.hidden.message": {
      "comment": "Explains how to reveal hidden media. Count is hidden rows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$(count)lld hidden item can be shown from the toolbar menu."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$(count)lld hidden items can be shown from the toolbar menu."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vous pouvez réafficher %1$(count)lld élément masqué depuis le menu de la barre d’outils."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vous pouvez réafficher %1$(count)lld éléments masqués depuis le menu de la barre d’outils."
                }
              }
            }
          }
        }
      }
    },
