    "NSLocalNetworkUsageDescription" : {
      "comment" : "System local network permission explanation. Keep the Apple-defined key unchanged.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext connects to your Sonarr, Radarr, and Jellyfin servers on your local network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext se connecte à vos serveurs Sonarr, Radarr et Jellyfin sur votre réseau local."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext 会连接您本地网络上的 Sonarr、Radarr 和 Jellyfin 服务器。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext はローカルネットワーク上の Sonarr、Radarr、Jellyfin サーバーに接続します。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل WatchNext بخوادم Sonarr وRadarr وJellyfin على شبكتك المحلية."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext подключается к вашим серверам Sonarr, Radarr и Jellyfin в локальной сети."
