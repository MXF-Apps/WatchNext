    "NSLocalNetworkUsageDescription" : {
      "comment" : "System local network permission explanation. Keep the Apple-defined key unchanged.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext connects to your Sonarr, Radarr, and Jellyfin servers on your local network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext se connecte à vos serveurs Sonarr, Radarr et Jellyfin sur votre réseau local."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext 会连接您本地网络上的 Sonarr、Radarr 和 Jellyfin 服务器。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext はローカルネットワーク上の Sonarr、Radarr、Jellyfin サーバーに接続します。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل WatchNext بخوادم Sonarr وRadarr وJellyfin على شبكتك المحلية."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext подключается к вашим серверам Sonarr, Radarr и Jellyfin в локальной сети."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext verbindet sich mit deinen Sonarr-, Radarr- und Jellyfin-Servern in deinem lokalen Netzwerk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext se conecta a tus servidores Sonarr, Radarr y Jellyfin en tu red local."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O WatchNext se conecta aos seus servidores Sonarr, Radarr e Jellyfin na sua rede local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext si connette ai tuoi server Sonarr, Radarr e Jellyfin sulla rete locale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext maakt verbinding met je Sonarr-, Radarr- en Jellyfin-servers in je lokale netwerk."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext는 로컬 네트워크의 Sonarr, Radarr, Jellyfin 서버에 연결합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext 會連線至您本機網路上的 Sonarr、Radarr 和 Jellyfin 伺服器。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchNext łączy się z Twoimi serwerami Sonarr, Radarr i Jellyfin w sieci lokalnej."
          }
        },
